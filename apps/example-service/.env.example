# Application Configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# Authentication
JWT_SECRET=change-this-secret-in-production

# Example: To test with a valid JWT token:
# Generate a token with: node -e "console.log(require('jsonwebtoken').sign({sub:'user-123',email:'test@example.com',name:'Test User',roles:['admin','user']}, 'change-this-secret-in-production', {expiresIn:'24h'}))"
