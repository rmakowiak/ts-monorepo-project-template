# Example Service Environment Configuration
# Copy this file to .env for local development
# See CONFIG.md for detailed documentation

# Environment file priority: .env.local > .env.production > .env

# Application Configuration
# PORT: HTTP server port (must be 1-65535)
PORT=8000

# NODE_ENV: Application environment (development | production | test)
NODE_ENV=development

# LOG_LEVEL: Logging verbosity (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Authentication
# JWT_SECRET: JWT signing secret
# - MUST be at least 32 characters (enforced in all environments)
# - Generate with: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production-at-least-32-chars

# Example: To test with a valid JWT token:
# Generate a token with: node -e "console.log(require('jsonwebtoken').sign({sub:'user-123',email:'test@example.com',name:'Test User',roles:['admin','user']}, 'dev-secret-change-in-production-at-least-32-chars', {expiresIn:'24h'}))"

# OpenTelemetry Configuration
# OTEL_SERVICE_NAME: Service name for traces and metrics (REQUIRED)
OTEL_SERVICE_NAME=example-service

# OTEL_SERVICE_VERSION: Service version for observability
OTEL_SERVICE_VERSION=1.0.0

# OTEL_ENABLED: Enable/disable OpenTelemetry (true | false)
OTEL_ENABLED=true

# Tracing Configuration
# OTEL_TRACING_ENABLED: Enable/disable distributed tracing (true | false)
OTEL_TRACING_ENABLED=true

# OTEL_TRACE_EXPORTER: Trace exporter type (otlp-http | console)
OTEL_TRACE_EXPORTER=otlp-http

# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT: OTLP trace receiver endpoint
# - Default: http://localhost:4318/v1/traces (Jaeger OTLP receiver)
# - Production: Update to your collector endpoint (e.g., https://collector.example.com:4318/v1/traces)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# OTEL_TRACE_SAMPLE_RATE: Trace sampling rate (0.0 to 1.0)
# - 1.0 = 100% (all requests traced) - use in development
# - 0.1 = 10% (10% of requests traced) - recommended for high-traffic production
OTEL_TRACE_SAMPLE_RATE=1.0

# Metrics Configuration
# OTEL_METRICS_ENABLED: Enable/disable metrics collection (true | false)
OTEL_METRICS_ENABLED=true

# OTEL_METRICS_PORT: Prometheus metrics endpoint port
# - Prometheus will scrape http://localhost:OTEL_METRICS_PORT/metrics
OTEL_METRICS_PORT=9464

# OTEL_RESOURCE_ATTRIBUTES: Additional resource attributes (comma-separated key=value pairs)
# - Optional: Add custom tags for filtering in observability platforms
# - Example: team=platform,region=us-east,env=local
# OTEL_RESOURCE_ATTRIBUTES=team=platform,region=us-east

# Quick Start Guide:
# 1. Start observability stack: cd ../../infrastructure && docker-compose up -d
# 2. Start service: pnpm dev
# 3. Make API requests to generate traces
# 4. View traces: http://localhost:16686 (Jaeger)
# 5. View metrics: http://localhost:9090 (Prometheus) or http://localhost:3000 (Grafana)
