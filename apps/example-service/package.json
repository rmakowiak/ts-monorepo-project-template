{
  "name": "@monorepo/example-service",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "style:format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "style:lint": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:unit": "jest --testPathPatterns='src/.*\\.spec\\.ts$'",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:integration:cov": "jest --config ./test/jest-integration.json --coverage",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:unit": "jest --coverage --testPathPatterns='src/.*\\.spec\\.ts$'",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/axios": "^3.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@monorepo/eslint-config": "workspace:*",
    "@monorepo/prettier-config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.18.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "9.37.0",
    "jest": "30.2.0",
    "jsonwebtoken": "^9.0.2",
    "prettier": "3.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!**/*.port.ts",
      "!**/*.error.ts",
      "!**/main.ts",
      "!**/*.module.ts",
      "!**/*.controller.ts",
      "!**/*.filter.ts",
      "!**/*.decorator.ts",
      "!**/config/**",
      "!**/indicators/**",
      "!**/adapters/simple-*.ts",
      "!**/auth/application/auth.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 75,
        "functions": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^~/(.*)$": "<rootDir>/$1"
    }
  }
}
