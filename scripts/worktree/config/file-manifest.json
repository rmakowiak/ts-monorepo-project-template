{
  "version": "1.0.0",
  "apps": {
    "example-service": {
      "files": [
        {
          "source": ".env.example",
          "destination": ".env",
          "required": true,
          "transform": "update_env_vars",
          "description": "Environment configuration from .env.example with ports and database URL updated"
        },
        {
          "source": "requests/http-client.env.json",
          "destination": "requests/http-client.env.json",
          "required": false,
          "transform": "update_base_url",
          "description": "HTTP client JWT tokens and baseUrl"
        }
      ]
    }
  }
}
